local data = require "_assets.School.quiz_data"

function init(self)
	-- 1. Setup Nodes
	self.question_text = gui.get_node("question_label")
	self.quiz_buttons = {
		gui.get_node("button1"),
		gui.get_node("button2"),
		gui.get_node("button3"),
		gui.get_node("button4")
	}
	-- We also need the text nodes inside the buttons
	self.button_labels = {
		gui.get_node("button1_text"),
		gui.get_node("button2_text"),
		gui.get_node("button3_text"),
		gui.get_node("button4_text")
	}

	self.exit_button = gui.get_node("exit")
	self.answered = false

	-- 2. Load a random question
	load_question(self, 1) -- Load the first question for now

	msg.post(".", "acquire_input_focus")
end

function load_question(self, index)
	local q = data.questions[index]
	self.correct_index = q.correct_index

	-- Set the main question text
	gui.set_text(self.question_text, q.question)

	-- Set the text for each button
	for i, label_node in ipairs(self.button_labels) do
		gui.set_text(label_node, q.answers[i])
		-- Reset button colors/textures if re-loading
		gui.play_flipbook(self.quiz_buttons[i], hash("default_button_blue"))
	end

	self.answered = false
end

-- Helper function to handle texture changes
local function reveal_answers(self)
	for i, node in ipairs(self.quiz_buttons) do
		local anim = (i == self.correct_index) and hash("right") or hash("wrong")
		gui.play_flipbook(node, anim)
	end
end

function on_input(self, action_id, action)
	if action_id == hash("touch") and action.pressed then

		-- Map screen touch to GUI coordinates if necessary
		-- local touch_x = action.x
		-- local touch_y = action.y

		-- 1. Check Exit Button
		if gui.pick_node(self.exit_button, action.x, action.y) then
			msg.post("main:/SceneParent#Main", "change_level", { target = "StartPage" })
			return 
		end

		-- 2. Check Quiz Buttons
		if not self.answered then
			for i, node in ipairs(self.quiz_buttons) do
				if gui.pick_node(node, action.x, action.y) then
					self.answered = true
					print("Selected option: " .. i)
					reveal_answers(self)
					break
				end
			end
		end
	end
end