local state = require "_scripts/MiniGame.Game_State"

go.property("score_meters", 0)

local lanes = {}
for i=1,25 do lanes[i] = i * 30 end
local coin_w = 26
local coinPowerUp_w = 5
local knowledgePowerUp_w = 3
local knowledgeItem_w = 0

local last_lane = 0
local LEVEL_CONFIG = {15, 20, 25, 25, 25, 30, 35, 40, 50} -- real
--local LEVEL_CONFIG = {2, 2, 2, 2, 2, 2, 2, 2, 20} --testing 

local function get_finish_weight(level_time)
	local x = math.min(math.max(level_time, 0), 9)
	return 8 * math.exp(-0.25 * x) + 2
end

local function spawn_obstacle(self)
	if not state.active then return end

	local current_lane = lanes[math.random(1, #lanes)]
	while math.abs(current_lane - last_lane) <= 40 do
		current_lane = lanes[math.random(1, #lanes)]
	end
	last_lane = current_lane

	local level_idx = self.current_level
	local level_time = os.clock() - self.level_start_time

	local finish_w = get_finish_weight(level_time)

	local weights = {
		{ id = "#tree_Factory", w = 0 },
		{ id = "#rock_Factory", w = 0 },
		{ id = "#coin_Factory", w = coin_w },
		{ id = "#finish_Factory", w = finish_w },
		{ id = "#coinPowerUp_Factory", w = coinPowerUp_w},
		{ id = "#knowledgePowerUp_Factory", w = knowledgePowerUp_w},
		{ id = "#knowledgeItem_Factory", w = knowledgeItem_w}
	}

	local current_total = 0
	for i=3, #weights do
		current_total = current_total + weights[i].w
	end

	local remaining_w = math.max(0, 100 - current_total)
	local obs_w = remaining_w / 2
	weights[1].w = obs_w
	weights[2].w = obs_w

	local roll = math.random() * 100
	local current = 0
	local selected_id = weights[1].id
	for _, t in ipairs(weights) do
		current = current + t.w
		if roll <= current then
			selected_id = t.id
			break
		end
	end

	local pos = vmath.vector3(current_lane, -50, 0.1)
	local spawned_id = factory.create(selected_id, pos)

	if selected_id == "#knowledgePowerUp_Factory" or selected_id == "#coinPowerUp_Factory" then
		table.insert(self.active_powerUps, spawned_id)
	end

	local base_speed = 300
	local final_speed = base_speed + (math.min(self.current_level, 8) - 1) * (500 / 7)

	msg.post(spawned_id, "set_speed", { speed = final_speed })
end

local function clear_all_powerups(self)
	for _, id in ipairs(self.active_powerUps) do
		pcall(msg.post, id, "force_despawn")
	end
	self.active_powerUps = {}
end

local function update_progression(self, dt)
	if not state.active then return end

	if self.coinPowerUpHit then
		self.coin_timer = self.coin_timer - dt
		if self.coin_timer <= 0 then
			coinPowerUp_w = 7
			self.coinPowerUpHit = false
			msg.post("/yeti_miniGame", "StopCoinPowerUp")
		end
	end

	if self.knowledgePowerUpHit then
		self.knowledge_timer = self.knowledge_timer - dt
		if self.knowledge_timer <= 0 then
			self.knowledgePowerUpHit = false
			coin_w = knowledgeItem_w
			knowledgeItem_w = 0
			knowledgePowerUp_w = 7
			print("STOPPING THE KNOWLEDGE POWERUP")
		end
	end

	self.level_timer = self.level_timer + dt
	self.total_time = self.total_time + dt

	local multiplier = 1 + (self.current_level * 0.5)
	self.score_meters = self.score_meters + (dt * 10 * multiplier)
	msg.post("hud_gui#hud", "update_score", { score = math.floor(self.score_meters) })

	local duration = LEVEL_CONFIG[self.current_level] or 999999
	if self.level_timer >= duration and self.current_level < 10 then
		self.current_level = self.current_level + 1
		self.level_timer = 0
		self.level_start_time = os.clock()

		if self.current_level >= 7 then
			self.spawn_interval = self.current_level == 7 and 0.25 or 0.15
		else
			self.spawn_interval = math.max(0.3, 1.0 - (self.current_level * 0.12))
		end

		timer.cancel(self.spawn_timer_handle)
		self.spawn_timer_handle = timer.delay(self.spawn_interval, true, spawn_obstacle)
	end
end

function init(self)
	state.active = true
	math.randomseed(os.time())
	coin_w = 20

	self.current_level = 1
	self.level_timer = 0
	self.total_time = 0
	self.level_start_time = os.clock()
	self.score_meters = 0
	self.spawn_interval = 1.0

	self.coinPowerUpHit = false
	self.knowledgePowerUpHit = false
	self.coin_timer = 0
	self.knowledge_timer = 0
	self.active_powerUps = {} 

	self.spawn_timer_handle = timer.delay(self.spawn_interval, true, spawn_obstacle)
end

function update(self, dt)
	update_progression(self, dt)
end

function on_message(self, message_id, message, sender)
	if message_id == hash("stop_spawning") then
		if self.spawn_timer_handle then timer.cancel(self.spawn_timer_handle) end
		state.active = false
	elseif message_id == hash("coinPowerUpHit") then 
		self.coinPowerUpHit = true
		coinPowerUp_w = 0
		self.coin_timer = 10
		clear_all_powerups(self)
	elseif message_id == hash("knowledgePowerUpHit") then
		self.knowledgePowerUpHit = true
		knowledgePowerUp_w = 0
		knowledgeItem_w = coin_w
		coin_w = 0
		self.knowledge_timer = 15
		clear_all_powerups(self)
	elseif message_id == hash("remove_from_list") then
		for i, id in ipairs(self.active_powerUps) do
			if id == message.id then
				table.remove(self.active_powerUps, i)
				break
			end
		end
	end
end