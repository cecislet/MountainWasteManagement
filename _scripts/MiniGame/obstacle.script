go.property("speed", 300) -- Velocità di scorrimento
local WINDOW_HEIGHT = tonumber(sys.get_config("display.height"))

function update(self, dt)
	local p = go.get_position()
	-- Muove l'oggetto verso il basso
	p.y = p.y + (self.speed * dt)
	go.set_position(p)

	-- Se l'ostacolo esce dal fondo dello schermo (y < -100), eliminalo
	if p.y > (WINDOW_HEIGHT + 100) then
		go.delete()
	end
end