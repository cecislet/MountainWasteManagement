local GameManager = require "_scripts.GameManager"

function on_message(self, message_id, message, sender)
	if message_id == hash("update_coins") then
		local label = gui.get_node("coin_label")
		-- Usa la stringa "label_coins" (Monete:) dal tuo file M.strings
		local prefix = GameManager.get_text("label_coins") or "Coins:"
		print("DEBUG: prefix for coins is:", prefix);
		gui.set_text(label, prefix .. " " .. math.floor(message.coins or 0))

	elseif message_id == hash("update_score") then
		local score_node = gui.get_node("score_label")
		-- "m" per metri solitamente rimane invariato, ma formattiamo il numero
		gui.set_text(score_node, string.format("%d m", math.floor(message.score or 0)))

	elseif message_id == hash("update_knowledge") then
		local score_node = gui.get_node("knowledge_label")
		-- Usa la stringa "label_knowledge" (Conoscenza:) dal tuo file M.strings
		local prefix = GameManager.get_text("label_knowledge") or "Knowledge:"
		gui.set_text(score_node, prefix .. " " .. math.floor(message.knowledge or 0))
	end
end

local function handle_button(self, node_id, action, message_to_player)
	local node = gui.get_node(node_id)
	if gui.pick_node(node, action.x, action.y) then
		if action.pressed then
			msg.post("/yeti_miniGame#skiing", message_to_player, { pressed = true })
			gui.set_color(node, vmath.vector4(1, 1, 1, 0.5)) 
		elseif action.released then
			msg.post("/yeti_miniGame#skiing", message_to_player, { pressed = false })
			gui.set_color(node, vmath.vector4(1, 1, 1, 1))
		end
	end
end

function on_input(self, action_id, action)
	if action_id == hash("touch") then
		handle_button(self, "leftButton", action, "move_left")
		handle_button(self, "rightButton", action, "move_right")
	end
end

function init(self)
	local mobile_root = gui.get_node("mobileControls")

	local is_mobile = false
	if sys.get_sys_info().system_name == "HTML5" then
		local js_code = " /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent) "
		is_mobile = html5.run(js_code) == "true"
	end

	if is_mobile then
		gui.set_enabled(mobile_root, true)
		msg.post(".", "acquire_input_focus")
	else
		gui.set_enabled(mobile_root, false)
	end

	msg.post("#", "update_coins", {coins = 0})
	msg.post("#", "update_knowledge", {knowledge = 0})
end