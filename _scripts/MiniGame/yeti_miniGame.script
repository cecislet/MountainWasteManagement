local WINDOW_WIDTH = tonumber(sys.get_config("display.width"))
local GameManager = require("_scripts.GameManager")
local speed = 500
local state = require "_scripts/MiniGame.Game_State"

function init(self)
	msg.post(".", "acquire_input_focus")
	self.dir = vmath.vector3()
	self.current_anim = hash("front")
end

function final(self)
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function update(self, dt)
	if vmath.length_sqr(self.dir) > 0 then
		self.dir = vmath.normalize(self.dir)
	end
	local p = go.get_position()
	local new_p = p + self.dir * speed * dt

	local shape_props = physics.get_shape("#yeti_collisionobject", "yeti_hitbox")
	local margin_x = shape_props.dimensions.x / 2

	if new_p.x < margin_x then
		new_p.x = margin_x
	elseif new_p.x > (WINDOW_WIDTH - margin_x) then
		new_p.x = WINDOW_WIDTH - margin_x
	end

	go.set_position(new_p)

	sprite.play_flipbook("#sprite", self.current_anim)

	self.dir = vmath.vector3()
end

function late_update(self, dt)
	-- This function is called at the end of update cycle but before render
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function fixed_update(self, dt)
	-- This function is called if 'Fixed Update Frequency' is enabled in the Engine section of game.project
	-- Can be coupled with fixed updates of the physics simulation if 'Use Fixed Timestep' is enabled in
	-- Physics section of game.project
	-- Add update code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function on_message(self, message_id, message, sender)
	-- Se il giocatore tocca un trigger (l'ostacolo)
	if message_id == hash("trigger_response") and message.enter then
		print("Game Over! Hai preso un ostacolo")
		msg.post("spawner#ObstacleSpawner", "stop_spawning")
		state.active = false
		msg.post("#", "disable") 
	end
end

function on_input(self, action_id, action)
	if action_id == hash("left") then
		self.dir.x = -1
	elseif action_id == hash("right") then
		self.dir.x = 1
	end
	self.dir.y = 0
end

function on_reload(self)
	-- Add reload-handling code here
	-- Learn more: https://defold.com/manuals/hot-reload/
	-- Remove this function if not needed
end
