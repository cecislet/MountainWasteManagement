local WINDOW_WIDTH = tonumber(sys.get_config("display.width"))
local GameManager = require("_scripts.GameManager")
--local api = require("_scripts.api") 
local state = require "_scripts/MiniGame.Game_State"

local speed = 500
local gainedCoins = 0
local gainedKnowledgeItems = 0
local coinPowerUp = false

-- Funzione di supporto per gestire l'input unificato
local function update_direction(self, axis, value, is_pressed)
	if is_pressed then
		self.dir[axis] = value
	else
		if self.dir[axis] == value then
			self.dir[axis] = 0
		end
	end
end

function init(self)
	msg.post("@render:", "use_fixed_fit_projection", { near = -1, far = 1 })
	msg.post(".", "acquire_input_focus")
	self.dir = vmath.vector3()
	self.current_anim = hash("front")
	gainedCoins = 0 

	-- Variabile di controllo per evitare collisioni multiple a fine partita
	self.is_ending = false 
end

function update(self, dt)
	local move_dir = vmath.vector3(self.dir.x, 0, 0)

	if vmath.length_sqr(move_dir) > 0 then
		move_dir = vmath.normalize(move_dir)
	end

	local p = go.get_position()
	local new_p = p + move_dir * speed * dt

	-- Calcolo margini con la hitbox
	local shape_props = physics.get_shape("#yeti_collisionobject", "yeti_hitbox")
	local margin_x = shape_props.dimensions.x / 2

	if new_p.x < margin_x then
		new_p.x = margin_x
	elseif new_p.x > (WINDOW_WIDTH - margin_x) then
		new_p.x = WINDOW_WIDTH - margin_x
	end

	local categories = { "head", "shirt", "pants" }
	for _, cat in ipairs(categories) do
		local gm_key = (cat == "head") and "hat" or cat
		local item_id = GameManager.equipped[gm_key]
		local sprite_url = msg.url(nil, cat, "sprite")

		if item_id and item_id ~= "none" then
			msg.post(sprite_url, "enable")

			local final_anim_name = item_id .. "-front";
			pcall(function()
				sprite.play_flipbook(sprite_url, hash(final_anim_name))
			end)
		else
			msg.post(sprite_url, "disable")
		end
	end

	go.set_position(new_p)
end

function on_message(self, message_id, message, sender)
	if message_id == hash("trigger_response") and message.enter then
		if self.is_ending then return end 

		local group = message.other_group

		if group == hash("CoinPowerUp")	then
			coinPowerUp = true -- aggiungere powerup (2x coins, knowledge bonuses)
			msg.post("spawner#ObstacleSpawner", "coinPowerUpHit")

		elseif group == hash("KnowledgePowerUp") then
			msg.post("spawner#ObstacleSpawner", "knowledgePowerUpHit")

		elseif group == hash("KnowledgeItem") then
			if coinPowerUp then
				gainedKnowledgeItems = gainedKnowledgeItems + 2
			else
				gainedKnowledgeItems = gainedKnowledgeItems + 1
			end
			msg.post("hud_gui#hud", "update_knowledge", {knowledge = gainedKnowledgeItems})

		elseif group == hash("Coin") then
			if coinPowerUp then
				gainedCoins = gainedCoins + 2
			else
				gainedCoins = gainedCoins + 1
			end
			msg.post("hud_gui#hud", "update_coins", {coins = gainedCoins})
			print("YEAH: hai preso una moneta!")
			-- Se la moneta non si distrugge da sola, aggiungi qui: go.delete(message.other_id)

		elseif group == hash("Tree") or group == hash("Rock") or group == hash("FinishLine") then
			-- Blocchiamo subito la logica
			self.is_ending = true
			state.active = false
			msg.post("spawner#ObstacleSpawner", "stop_spawning")

			local current_meters = math.floor(go.get("spawner#ObstacleSpawner", "score_meters"))

			-- 2. Controlla e aggiorna il record nel GameManager
			local is_new_record = GameManager.update_high_score(current_meters)

			local data = {
				coins = gainedCoins, 
				knowledge = gainedKnowledgeItems, 
				score = current_meters,
				reason = (group == hash("FinishLine")) and "msg_victory" or "msg_gameover"
			}

			-- 1. Aggiorna i dati nel GameManager locale (UNA SOLA VOLTA)
			GameManager.coins = (GameManager.coins or 0) + gainedCoins
			GameManager.knowledge_amount = (GameManager.knowledge_amount or 0) + gainedKnowledgeItems

			if group == hash("FinishLine") then
				data.reason = "msg_victory"  -- Usa la chiave, non il testo
				GameManager.add_mood(20)
			else
				data.reason = "msg_gameover" -- Usa la chiave, non il testo
				if GameManager.hunger < 100 then
					GameManager.hunger = (GameManager.hunger or 100) + 10
				end
				if GameManager.mood >= 10 then
					GameManager.add_mood(-10)
				end
			end

			-- 2. Salvataggio su Database (Appwrite)
			print("Salvataggio dati su DB in corso...")

			-- 1. Mostra il menu IMMEDIATAMENTE
			msg.post("main:/SceneParent#Main", "show_end_menu", data)

			-- 2. Chiedi alla Scena Madre (o un oggetto persistente) di salvare
			-- Invece di api.save qui, inviamo un messaggio a un oggetto che NON viene disabilitato
			msg.post("main:/SceneParent#Main", "trigger_remote_save")

			-- 3. Ora puoi disabilitare il giocatore in sicurezza
			msg.post("#", "disable")
		end -- Fine blocco ostacoli

	elseif message_id == hash("move_left") then
		update_direction(self, "x", -1, message.pressed)
	elseif message_id == hash("move_right") then
		update_direction(self, "x", 1, message.pressed)
	elseif message_id == hash("StopCoinPowerUp") then
		coinPowerUp = false
	end
end

function on_input(self, action_id, action)
	if action_id == hash("left") then
		update_direction(self, "x", -1, not action.released)
	elseif action_id == hash("right") then
		update_direction(self, "x", 1, not action.released)
	end
	return false 
end