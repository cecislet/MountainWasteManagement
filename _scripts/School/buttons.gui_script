local data = require "_assets.School.quiz_data"
-- 1. Import your GameManager
local gm = require "_scripts.GameManager" -- Adjust path to where GameManager.lua is

local function reveal_answers(self)
	for i, node in ipairs(self.quiz_buttons) do
		if gui.is_enabled(node) then -- Only animate buttons that are visible
			local anim = (i == self.correct_index) and hash("right") or hash("wrong")
			gui.play_flipbook(node, anim)
		end
	end
end

local load_question 

load_question = function(self, index)
	if not data.questions[index] then
		print("Quiz Finished! Total Knowledge: " .. gm.knowledge_amount)
		msg.post("main:/SceneParent#Main", "change_level", { target = "StartPage" })
		return
	end

	self.current_question_index = index
	local q = data.questions[index]
	self.correct_index = q.correct_index

	gui.set_text(self.question_text, q.question)

	for i, node in ipairs(self.quiz_buttons) do
		if q.answers[i] then
			gui.set_enabled(node, true)
			gui.set_text(self.button_labels[i], q.answers[i])
			gui.play_flipbook(node, hash("neutral"))
		else
			gui.set_enabled(node, false) -- Hide buttons 3 and 4 if only 2 answers exist
		end
	end

	self.answered = false
end

function init(self)
	self.question_text = gui.get_node("questionText")
	self.quiz_buttons = {
		gui.get_node("button1"), gui.get_node("button2"),
		gui.get_node("button3"), gui.get_node("button4")
	}
	self.button_labels = {
		gui.get_node("text1"), gui.get_node("text2"),
		gui.get_node("text3"), gui.get_node("text4")
	}
	self.exit_button = gui.get_node("exit")

	load_question(self, 1)
	msg.post(".", "acquire_input_focus")
end

function on_input(self, action_id, action)
	if action_id == hash("touch") and action.pressed then
		-- ... (exit button code)

		if not self.answered then
			for i, node in ipairs(self.quiz_buttons) do
				-- ADD THE IS_ENABLED CHECK HERE
				if gui.is_enabled(node) and gui.pick_node(node, action.x, action.y) then
					self.answered = true

					print("Clicked Index: " .. i .. " | Correct Index: " .. self.correct_index)

					if i == self.correct_index then
						gm.knowledge_amount = gm.knowledge_amount + 1
						print("Correct!")
					else
						print("Wrong!")
					end

					reveal_answers(self)

					timer.delay(2, false, function()
						load_question(self, self.current_question_index + 1)
					end)
					break
				end
			end
		end
	end
end