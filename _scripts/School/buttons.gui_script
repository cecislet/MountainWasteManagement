local data = require "_assets.School.quiz_data"
local gm = require "_scripts.GameManager"
local api = require "_scripts.api" 

-- Variabile di controllo per evitare salvataggi multipli contemporanei
local is_saving = false

local function update_ui_visibility(self)
	gui.set_enabled(self.info_box_node, self.info_open)
	local quiz_enabled = not self.info_open

	gui.set_enabled(self.question_node, quiz_enabled)
	
	for _, node in ipairs(self.quiz_buttons) do
		if self.active_buttons[node] then
			gui.set_enabled(node, quiz_enabled)
		end
	end
	gui.set_enabled(self.exit_button, quiz_enabled)
	gui.set_enabled(self.info_button, quiz_enabled)
end

local function reveal_answers(self)
	for i, node in ipairs(self.quiz_buttons) do
		if gui.is_enabled(node) then
			local anim = (i == self.correct_index) and hash("9SliceRightButton") or hash("9SliceWrongButton")
			gui.play_flipbook(node, anim)
		end
	end
end

local load_question -- Forward declaration

load_question = function(self, index)
	-- Se non ci sono più domande, il quiz è finito
	if not self.selected_questions[index] then
		if is_saving then return end
		is_saving = true

		-- Sostituisci la stringa fissa con:
		gui.set_text(self.question_text, gm.get_text("quiz_finished"))

		-- Salvataggio asincrono su Appwrite
		api.save(self, function()
			is_saving = false
			msg.post("main:/SceneParent#Main", "change_level", { target = "StartPage" })
		end)
		return
	end

	self.current_question_index = index
	local q = self.selected_questions[index]
	self.correct_index = q.correct_index

	local translated_question = gm.get_text(q.question)
	gui.set_text(self.question_text, translated_question)

	for i, node in ipairs(self.quiz_buttons) do
		if q.answers[i] then
			gui.set_enabled(node, true)

			-- TRADUZIONE DELLA RISPOSTA
			local translated_answer = gm.get_text(q.answers[i])
			gui.set_text(self.button_labels[i], translated_answer)

			gui.play_flipbook(node, hash("9SliceButton"))
			self.active_buttons[node] = true 
		else
			gui.set_enabled(node, false) 
			self.active_buttons[node] = false
		end
	end

	self.answered = false
end

local function update_ui_texts(self)
	gui.set_text(self.info_text_node, gm.get_text("school_guide"))

	-- Traduzione del tasto per chiudere il popup (nodo 'exitText' nell'immagine)
	gui.set_text(gui.get_node("exitText"), gm.get_text("close"))
end

local function get_random_questions(all_questions, count)
	local shuffled = {}
	for i, v in ipairs(all_questions) do shuffled[i] = v end
	for i = #shuffled, 2, -1 do
		local j = math.random(i)
		shuffled[i], shuffled[j] = shuffled[j], shuffled[i]
	end
	local result = {}
	for i = 1, math.min(count, #shuffled) do table.insert(result, shuffled[i]) end
	return result
end

function init(self)
	msg.post("@render:", "use_fixed_fit_projection", { near = -1, far = 1 })
	-- Seed del generatore casuale più preciso
	math.randomseed(os.time() + os.clock())
	math.random(); math.random(); math.random()

	is_saving = false
	self.selected_questions = get_random_questions(data.questions, 5)
	self.question_node = gui.get_node("question/button_root")
	self.question_text = gui.get_node("question/label")

	self.quiz_buttons = {
		gui.get_node("button1/button_root"),
		gui.get_node("button2/button_root"),
		gui.get_node("button3/button_root"),
		gui.get_node("button4/button_root")
	}

	self.button_labels = {
		gui.get_node("button1/label"),
		gui.get_node("button2/label"),
		gui.get_node("button3/label"),
		gui.get_node("button4/label")
	}

	self.info_button = gui.get_node("info")
	self.info_box_node = gui.get_node("infoBox")
	self.info_text_node = gui.get_node("infoText")
	self.info_click_shield = gui.get_node("box")
	self.exit_button = gui.get_node("exit")

	self.info_open = false
	self.active_buttons = {}

	update_ui_texts(self)

	load_question(self, 1)
	update_ui_visibility(self)
	msg.post(".", "acquire_input_focus")
end

function on_input(self, action_id, action)
	if action_id == hash("touch") and action.pressed then

		-- Se stiamo già salvando, blocca ogni altro input
		if is_saving then return true end

		-- Gestione Popup Info
		if self.info_open then
			if gui.pick_node(self.info_click_shield, action.x, action.y) then
				self.info_open = false
				update_ui_visibility(self)
			end
			return true 
		end

		-- Tasto Info (Guida Generale)
		if gui.pick_node(self.info_button, action.x, action.y) then
			gui.set_text(self.info_text_node, gm.get_text("school_guide")) -- Torna alla guida
			self.info_open = true
			update_ui_visibility(self)
			return true
		end

		-- Tasto NPC (Il Gufo)
		if gui.pick_node(gui.get_node("npc"), action.x, action.y) then
			-- Scegli un consiglio casuale (1-10)
			local random_id = "owl_" .. math.random(1, 20)
			local tip_text = gm.get_text(random_id)

			gui.set_text(self.info_text_node, tip_text) -- Mostra il consiglio
			self.info_open = true
			update_ui_visibility(self)
			return true
		end

		-- Tasto Exit (con salvataggio)
		if gui.pick_node(self.exit_button, action.x, action.y) then
			is_saving = true
			-- Sostituisci la stringa fissa con:
			gui.set_text(self.question_text, gm.get_text("saving"))

			api.save(self, function()
				is_saving = false
				msg.post("main:/SceneParent#Main", "change_level", { target = "StartPage" })
			end)
			return true 
		end

		-- Selezione Risposta
		if not self.answered then
			for i, node in ipairs(self.quiz_buttons) do
				if gui.is_enabled(node) and gui.pick_node(node, action.x, action.y) then
					self.answered = true

					if i == self.correct_index then
						gm.add_mood(5)
						gm.knowledge_amount = (gm.knowledge_amount or 0) + 2
					else
						gm.add_mood(-10)
					end

					reveal_answers(self)

					-- Aspetta 2 secondi per mostrare il risultato, poi carica la prossima
					timer.delay(2, false, function()
						load_question(self, self.current_question_index + 1)
					end)
					return true 
				end
			end
		end
	end
end