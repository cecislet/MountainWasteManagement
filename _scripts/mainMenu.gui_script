local gm = require "_scripts.GameManager"
local api = require "_scripts.api"

-- CONFIGURAZIONE APPWRITE
local PROJECT_ID = "69d189c1001e4c58e744"
local BASE_URL = "https://cloud.appwrite.io/v1"
local SUFFIX = "@game.io" 

-- --- FUNZIONI UTILITY ---

local function is_valid_username(str)
	return str:match("^[a-zA-Z0-9]+$") ~= nil
end

local function show_popup(self, message)
	gui.set_text(gui.get_node("errText"), message)
	gui.set_enabled(gui.get_node("errBox"), true)
end

-- --- FUNZIONI DI RETE ---

-- 1. LOGIN + CARICAMENTO DATI + ENTRATA DIRETTA
-- Nel MainMenu.lua
local function appwrite_login(self, username, password, quiet)
	gm.reset_player_data()
	local email = username .. SUFFIX
	local url = BASE_URL .. "/account/sessions/email"
	local payload = { email = email, password = password }
	local headers = { ["Content-Type"] = "application/json", ["X-Appwrite-Project"] = PROJECT_ID }

	http.request(url, "POST", function(self, id, response)
		if response.status == 201 then
			local data = json.decode(response.response)
			gm.player_id = data.userId
			gm.name = username

			print("mood: " .. gm.mood)
			
			self.is_logged_in = true

			gui.hide_keyboard() 

			api.load(self, function(success)
				if success then
					api.save(self, function(saved)
					end)
				else
					api.save(self, function(saved)
					end)
				end

				if not quiet then
					msg.post("main:/SceneParent#Main", "change_level", { target = "StartPage"})
				end
			end)
		else
			show_popup(self, gm.get_text("login_failed"))
		end
	end, headers, json.encode(payload))
end

-- 2. REGISTRAZIONE
local function appwrite_register(self, username, password)
	local email = username .. SUFFIX
	local url = BASE_URL .. "/account"
	local payload = {
		userId = "unique()",
		email = email,
		password = password,
		name = username
	}
	local headers = { ["Content-Type"] = "application/json", ["X-Appwrite-Project"] = PROJECT_ID }

	http.request(url, "POST", function(self, id, response)
		if response.status == 201 then
			print("Registrazione OK, entro nel gioco...")
			appwrite_login(self, username, password, false)
			gm.high_score = 0
			gm.knowledge_amount = 0
			gm.coins = 0
			gm.hunger = 51
			gm.mood = 70
			gm.high_score = 0
		else
			local err = json.decode(response.response)
			show_popup(self, gm.get_text("registration_failed") or ("ERROR: " .. (err.message or "Registration faailed")))
		end
	end, headers, json.encode(payload))
end

-- --- FUNZIONI DEFOLD ---

-- Funzione helper per aggiornare i testi nella UI
local function update_ui_texts(self)
	-- --- TESTI MENU PRINCIPALE ---
	gui.set_text(gui.get_node("playTxt"), gm.get_text("play"))
	gui.set_text(gui.get_node("creditsTxt"), gm.get_text("credits"))
	gui.set_text(gui.get_node("storyTxt"), gm.get_text("story"))

	-- --- TESTI LOGIN FORM (image_9f7b60.png) ---
	-- Etichette dei campi
	gui.set_text(gui.get_node("username"), gm.get_text("label_username")) -- "Username:"
	gui.set_text(gui.get_node("password"), gm.get_text("label_password")) -- "Password:"

	-- Placeholder (mostrati solo se i campi sono vuoti, opzionale)
	if self.username_text == "" then
		gui.set_text(gui.get_node("usernameTxt"), gm.get_text("insert_user")) -- "Insert Username"
	end
	if self.password_text == "" then
		gui.set_text(gui.get_node("passwordTxt"), gm.get_text("insert_pass")) -- "Insert Password"
	end

	-- Pulsanti del Form
	gui.set_text(gui.get_node("sendTxt"), gm.get_text("login"))      -- Pulsante LOGIN
	gui.set_text(gui.get_node("registerTxt"), gm.get_text("register")) -- Pulsante REGISTER
	gui.set_text(gui.get_node("backTxt"), gm.get_text("back"))        -- Pulsante BACK

	-- --- TESTI EXTRA (Debug e Errori) ---
	--gui.set_text(gui.get_node("text"), gm.get_text("debug_access")) -- Pulsante DEBUG
	gui.set_text(gui.get_node("exitErrText"), gm.get_text("close"))     -- Pulsante CLOSE popup
end

function init(self)
	msg.post(".", "acquire_input_focus")

	gui.set_enabled(gui.get_node("Menu"), true)
	gui.set_enabled(gui.get_node("loginForm"), false)
	gui.set_enabled(gui.get_node("errBox"), false)

	self.is_logged_in = false
	self.show_password = false
	self.active_field = nil
	self.username_text = ""
	self.password_text = ""

	if gm.current_language == "en" then
		gui.play_flipbook(gui.get_node("flag"), "USA")
	else
		gui.play_flipbook(gui.get_node("flag"), "SwissItaly")
	end

	gm.load_language(gm.current_language)
	update_ui_texts(self)
end

function on_input(self, action_id, action)
	if action_id == hash("touch") and action.pressed then

		-- --- CAMBIO LINGUA (Bottone Flag) ---
		if gui.pick_node(gui.get_node("flag"), action.x, action.y) then
			if gm.current_language == "it" then
				gm.load_language("en")
				gui.play_flipbook(gui.get_node("flag"), "USA") -- Nome dell'immagine nell'atlas
			else
				gm.load_language("it")
				gui.play_flipbook(gui.get_node("flag"), "SwissItaly") -- Nome dell'immagine nell'atlas
			end

			update_ui_texts(self)
			return true
		end
		
		-- Gestione errore popup
		if gui.is_enabled(gui.get_node("errBox")) then
			if gui.pick_node(gui.get_node("closeErr"), action.x, action.y) then
				gui.set_enabled(gui.get_node("errBox"), false)
			end
			return true 
		end

		local menu = gui.get_node("Menu")
		local form = gui.get_node("loginForm")

		if gui.is_enabled(menu) then
			-- --- TASTO DEBUG VELOCE ---
			--if gui.pick_node(gui.get_node("DebugButton"), action.x, action.y) then
			--	appwrite_login(self, "Corrente", "Sirius2112", false)
			--	return true 
			--end

			if gui.pick_node(gui.get_node("PlayButton"), action.x, action.y) then
				if self.is_logged_in then
					msg.post("main:/SceneParent#Main", "change_level", { target = "StartPage"})
				else
					gui.set_enabled(menu, false)
					gui.set_enabled(form, true)
				end
				return true

			elseif gui.pick_node(gui.get_node("Login"), action.x, action.y) then
				gui.set_enabled(menu, false)
				gui.set_enabled(form, true)
				return true

				-- --- NUOVA LOGICA STORY ---
			elseif gui.pick_node(gui.get_node("StoryButton"), action.x, action.y) then
				local msg = gm.get_text("story_text") 
				show_popup(self, msg)
				return true

				-- --- NUOVA LOGICA CREDITS ---
			elseif gui.pick_node(gui.get_node("CreditsButton"), action.x, action.y) then
				-- Mostra il popup con i crediti
				local msg = gm.get_text("creditsNames")
				show_popup(self, msg)
				return true
			end

		elseif gui.is_enabled(form) then
			local user_bg = gui.get_node("usernameBg")
			local pass_bg = gui.get_node("passwordBg")

			if gui.pick_node(user_bg, action.x, action.y) then
				self.active_field = "username"
				gui.set_color(user_bg, vmath.vector4(1, 1, 1, 1))
				gui.set_color(pass_bg, vmath.vector4(0.3, 0.3, 0.3, 1))
				gui.show_keyboard(gui.KEYBOARD_TYPE_DEFAULT, true)

			elseif gui.pick_node(pass_bg, action.x, action.y) then
				self.active_field = "password"
				gui.set_color(pass_bg, vmath.vector4(1, 1, 1, 1))
				gui.set_color(user_bg, vmath.vector4(0.3, 0.3, 0.3, 1))
				gui.show_keyboard(gui.KEYBOARD_TYPE_PASSWORD, true)

			elseif gui.pick_node(gui.get_node("viewPassword"), action.x, action.y) then
				self.show_password = not self.show_password
				local txt = self.show_password and self.password_text or string.rep("*", #self.password_text)
				gui.set_text(gui.get_node("passwordTxt"), txt)

			elseif gui.pick_node(gui.get_node("SendButton"), action.x, action.y) then
				if #self.username_text > 0 and #self.password_text > 0 then
					appwrite_login(self, self.username_text, self.password_text, false)
				else
					show_popup(self, gm.get_text("missing_data"))
				end

			elseif gui.pick_node(gui.get_node("BackButton"), action.x, action.y) then
				gui.set_enabled(form, false)
				gui.set_enabled(menu, true)
				self.active_field = nil
				gui.hide_keyboard()
				
			elseif gui.pick_node(gui.get_node("RegisterButton"), action.x, action.y) then
				if not is_valid_username(self.username_text) then
					show_popup(self, gm.get_text("invalid_username"))
				elseif #self.password_text < 8 then
					show_popup(self, gm.get_text("short_psw"))
				else
					appwrite_register(self, self.username_text, self.password_text)
				end
			end
		end
	end

	-- GESTIONE TASTIERA
	if self.active_field and gui.is_enabled(gui.get_node("loginForm")) and not gui.is_enabled(gui.get_node("errBox")) then
		if action_id == hash("text") then
			if self.active_field == "username" and #self.username_text < 20 then
				self.username_text = self.username_text .. action.text
				gui.set_text(gui.get_node("usernameTxt"), self.username_text)
			elseif self.active_field == "password" and #self.password_text < 20 then
				self.password_text = self.password_text .. action.text
				local display = self.show_password and self.password_text or string.rep("*", #self.password_text)
				gui.set_text(gui.get_node("passwordTxt"), display)
			end
		elseif action_id == hash("backspace") and action.pressed then
			if self.active_field == "username" then
				self.username_text = string.sub(self.username_text, 1, -2)
				gui.set_text(gui.get_node("usernameTxt"), self.username_text)
			else
				self.password_text = string.sub(self.password_text, 1, -2)
				local display = self.show_password and self.password_text or string.rep("*", #self.password_text)
				gui.set_text(gui.get_node("passwordTxt"), display)
			end
		elseif action_id == hash("enter") and action.pressed then
			gui.hide_keyboard()
			self.active_field = nil
		end
	end
end

