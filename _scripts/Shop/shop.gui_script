local GameManager = require "_scripts.GameManager"
local api = require "_scripts.api"

local function is_unlocked(item_id)
	for _, id in ipairs(GameManager.unlocked_items or {}) do
		if id == item_id then return true end
	end
	return false
end

-- Funzione di utilità per trovare la tabella corretta (hats vs pants)
local function get_items_table(category)
	-- Se esiste la versione con la 's' (hats), usa quella. 
	-- Se è già plurale (pants), usa quella originale.
	local plurale = category .. "s"
	if GameManager.cosmetics[plurale] then
		return GameManager.cosmetics[plurale], plurale
	else
		return GameManager.cosmetics[category], category
	end
end

local function update_item_preview(self, category)
	local items, cat_key = get_items_table(category)
	if not items then 
		print("ERRORE: Categoria non trovata nel GameManager: " .. category)
		return 
	end

	local index = self.indices[category]
	local item = items[index]
	if not item then return end

	-- 1. Aggiornamento Visivo Yeti 
	local visual_node = gui.get_node(category)
	if item.id == "none" then
		gui.set_enabled(visual_node, false)
	else
		gui.set_enabled(visual_node, true)
		local shop_anim = hash(item.id .. "-front") 
		pcall(function() gui.play_flipbook(visual_node, shop_anim) end)
	end

	-- 2. Gestione Nodi Prezzo e Testo
	local capitalized = category:gsub("^%l", string.upper)
	local btn_text_node = gui.get_node("buy" .. capitalized .. "Text")
	local price_container = gui.get_node("price" .. capitalized)
	local price_text_node = gui.get_node("pricetext" .. capitalized)

	local currently_equipped = GameManager.equipped[category] == item.id

	if is_unlocked(item.id) then
		gui.set_enabled(price_container, false)
		if currently_equipped then
			gui.set_text(btn_text_node, "---") 
		else
			gui.set_text(btn_text_node, GameManager.get_text("equip_btn"))
		end
	else
		gui.set_text(btn_text_node, GameManager.get_text("buy_btn"))
		gui.set_enabled(price_container, true)
		gui.set_text(price_text_node, tostring(item.price))
	end
end

local function update_ui_texts(self)
	gui.set_text(gui.get_node("infoText"), GameManager.get_text("shop_guide"))
	gui.set_text(gui.get_node("exitText"), GameManager.get_text("close_btn"))
end

function init(self)
	msg.post(".", "acquire_input_focus")
	self.indices = { hat = 1, shirt = 1, pants = 1 }
	self.info_open = false
	self.is_saving = false

	update_ui_texts(self)
	update_item_preview(self, "hat")
	update_item_preview(self, "shirt")
	update_item_preview(self, "pants")

	gui.set_enabled(gui.get_node("infoBox"), false)
end

function on_input(self, action_id, action)
	if action_id == hash("touch") and action.pressed then
		if self.is_saving then return end

		-- Gestione InfoBox
		if self.info_open then
			if gui.pick_node(gui.get_node("exitInfo"), action.x, action.y) then
				self.info_open = false
				gui.set_enabled(gui.get_node("infoBox"), false)
				return true
			end
			return true
		end

		if gui.pick_node(gui.get_node("info"), action.x, action.y) then
			self.info_open = true
			gui.set_enabled(gui.get_node("infoBox"), true)
			return true
		end

		-- Logica Shop (Frecce e Acquisto)
		local categories = {"Hat", "Shirt", "Pants"}
		for _, cat in ipairs(categories) do
			local low_cat = cat:lower()
			local items, cat_key = get_items_table(low_cat)

			if items then
				-- Frecce
				if gui.pick_node(gui.get_node("next" .. cat), action.x, action.y) then
					self.indices[low_cat] = self.indices[low_cat] + 1
					if self.indices[low_cat] > #items then self.indices[low_cat] = 1 end
					update_item_preview(self, low_cat)
					return true
				elseif gui.pick_node(gui.get_node("prev" .. cat), action.x, action.y) then
					self.indices[low_cat] = self.indices[low_cat] - 1
					if self.indices[low_cat] < 1 then self.indices[low_cat] = #items end
					update_item_preview(self, low_cat)
					return true
				end

				-- Tasto Buy/Equip
				if gui.pick_node(gui.get_node("buy" .. cat), action.x, action.y) then
					local item = items[self.indices[low_cat]]

					if is_unlocked(item.id) then
						if GameManager.equipped[low_cat] ~= item.id then
							GameManager.equipped[low_cat] = item.id
							self.is_saving = true
							api.save(self, function(success)
								self.is_saving = false
								if success then update_item_preview(self, low_cat) end
							end)
						end
					elseif GameManager.coins >= item.price then
						GameManager.coins = GameManager.coins - item.price
						table.insert(GameManager.unlocked_items, item.id)
						GameManager.equipped[low_cat] = item.id 

						self.is_saving = true
						api.save(self, function(success)
							self.is_saving = false
							if success then update_item_preview(self, low_cat) end
						end)
					end
					return true
				end
			end
		end

		if gui.pick_node(gui.get_node("exit"), action.x, action.y) then
			msg.post("main:/SceneParent#Main", "change_level", { target = "StartPage" })
			return true
		end
	end
end