local speed = 300
local GameManager = require("_scripts.GameManager")

local WINDOW_WIDTH = tonumber(sys.get_config("display.width"))
local WINDOW_HEIGHT = tonumber(sys.get_config("display.height"))

function init(self)
	msg.post(".", "acquire_input_focus")
	self.dir = vmath.vector3()
	self.current_anim = nil
	self.correction = vmath.vector3()

	-- Setup margini collisione
	local shape_props = physics.get_shape("#yeti_collisionobject", "yeti_hitbox")
	self.margin_x = shape_props.dimensions.x / 2
	self.margin_y = shape_props.dimensions.y / 2
	msg.post("#", "sync_clothes")
end

function update(self, dt)
	self.correction = vmath.vector3()

	-- 1. Calcolo Movimento
	local move_dir = vmath.vector3(self.dir.x, self.dir.y, 0)
	if vmath.length_sqr(move_dir) > 1 then
		move_dir = vmath.normalize(move_dir)
	end

	local p = go.get_position()
	local new_p = p + move_dir * speed * dt

	go.set_position(new_p)

	-- 2. Calcolo Animazione Corrente
	local is_moving = vmath.length_sqr(move_dir) > 0.1
	local anim = self.current_anim

	if is_moving then
		if math.abs(move_dir.x) > math.abs(move_dir.y) then
			anim = (move_dir.x > 0) and hash("right") or hash("left")
		else
			anim = (move_dir.y > 0) and hash("back") or hash("front")
		end
	else
		anim = hash("idle_front") -- Default idle
	end

	-- 3. Applicazione Animazioni (Yeti + Vestiti)
	if anim ~= self.current_anim then
		self.current_anim = anim
		sprite.play_flipbook("#sprite", anim)

		-- Determiniamo il suffisso basandoci sull'animazione dello Yeti
		local suffix = ""
		if anim == hash("right") then 
			suffix = "-right"
		elseif anim == hash("left") then 
			suffix = "-left"
		elseif anim == hash("back") then 
			suffix = "-back"
		elseif anim == hash("front") then 
			suffix = "-front"
		else
			suffix = "-idle" -- Per hash("idle_front") o altri stati fermi
		end

		local categories = { "head", "shirt", "pants" }
		for _, cat in ipairs(categories) do
			local gm_key = (cat == "head") and "hat" or cat
			local item_id = GameManager.equipped[gm_key]
			local sprite_url = msg.url(nil, cat, "sprite")

			if item_id and item_id ~= "none" then
				msg.post(sprite_url, "enable")

				-- Componiamo il nome: es. "ColorfulHat" .. "-front"
				local final_anim_name = item_id .. suffix

				-- Usiamo pcall per evitare crash se manca un'animazione specifica nel Tile Source
				pcall(function()
					sprite.play_flipbook(sprite_url, hash(final_anim_name))
				end)
			else
				msg.post(sprite_url, "disable")
			end
		end
	end

	-- 4. Z-Sorting dinamico (Yeti nel mondo)
	local pos = go.get_position()
	-- Moltiplichiamo per 0.1 per far sì che lo Yeti resti sempre tra Z 0.0 e 0.1
	-- Così non raggiungerà mai il limite di 1.0 della telecamera
	local base_z = (1 - (pos.y / 10000)) * 0.1 
	pos.z = base_z
	go.set_position(pos)

	-- 5. FORZA I VESTITI SOPRA IL CORPO
	-- Usiamo un valore piccolissimo per non rischiare di uscire dal range
	local offset_z = 0.001 

	local head_pos = go.get_position("head")
	head_pos.z = offset_z
	go.set_position(head_pos, "head")

	local shirt_pos = go.get_position("shirt")
	shirt_pos.z = offset_z
	go.set_position(shirt_pos, "shirt")

	local pants_pos = go.get_position("pants")
	pants_pos.z = offset_z
	go.set_position(pants_pos, "pants")
end

local function update_direction(self, axis, value, is_pressed)
	if is_pressed then
		self.dir[axis] = value
	elseif self.dir[axis] == value then
		self.dir[axis] = 0
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("trigger_response") and message.enter then
		local targets = {
			[hash("Game")] = "MiniGame",
			[hash("School")] = "School",
			[hash("Market")] = "Market",
			[hash("Shop")] = "Shop"
		}
		local target = targets[message.other_group]
		if target then
			msg.post("main:/SceneParent#Main", "change_level", { target = target })
		end
	end

	if message_id == hash("sync_clothes") then
		-- Forza il cambio animazione per far scattare l'aggiornamento dei vestiti
		self.current_anim = nil 
	end
	
	-- Gestione collisioni muri/ostacoli
	if message_id == hash("contact_point_response") then
		if message.group == hash("Fence") and message.distance > 0 then
			local proj = vmath.project(self.correction, message.normal * message.distance)
			if proj < 1 then
				local comp = (message.distance - message.distance * proj) * message.normal
				go.set_position(go.get_position() + comp)
				self.correction = self.correction + comp
			end
		end
	end
end

function on_input(self, action_id, action)
	local is_pressed = not action.released
	if action_id == hash("up") then update_direction(self, "y", 1, is_pressed)
	elseif action_id == hash("down") then update_direction(self, "y", -1, is_pressed)
	elseif action_id == hash("left") then update_direction(self, "x", -1, is_pressed)
	elseif action_id == hash("right") then update_direction(self, "x", 1, is_pressed)
	end
end