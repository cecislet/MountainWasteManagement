local speed = 300
local GameManager = require("_scripts.GameManager")

local WINDOW_WIDTH = tonumber(sys.get_config("display.width"))
local WINDOW_HEIGHT = tonumber(sys.get_config("display.height"))

function init(self)
	msg.post(".", "acquire_input_focus")
	self.dir = vmath.vector3()
	self.current_anim = nil

	-- Optimization: Cache these so you don't call physics.get_shape 60 times a second
	local shape_props = physics.get_shape("#yeti_collisionobject", "yeti_hitbox")
	self.margin_x = shape_props.dimensions.x / 2
	self.margin_y = shape_props.dimensions.y / 2
end

function update(self, dt)
	local move_dir = vmath.vector3(self.dir.x, self.dir.y, 0)
	if vmath.length_sqr(move_dir) > 1 then
		move_dir = vmath.normalize(move_dir)
	end

	local p = go.get_position()
	local new_p = p + move_dir * speed * dt

	-- Screen Clamping
	new_p.x = math.max(self.margin_x, math.min(new_p.x, WINDOW_WIDTH - self.margin_x))
	new_p.y = math.max(self.margin_y, math.min(new_p.y, WINDOW_HEIGHT - self.margin_y))

	go.set_position(new_p)

	-- Animation Logic
	local anim = self.current_anim or hash("front")
	if move_dir.x > 0 then anim = hash("right")
	elseif move_dir.x < 0 then anim = hash("left")
	elseif move_dir.y > 0 then anim = hash("back")
	elseif move_dir.y < 0 then anim = hash("front")
	end

	if anim ~= self.current_anim then
		sprite.play_flipbook("#sprite", anim)
		self.current_anim = anim
	end
end

local function update_direction(self, axis, value, is_pressed)
	if is_pressed then
		self.dir[axis] = value
	elseif self.dir[axis] == value then
		self.dir[axis] = 0
	end
end

function on_message(self, message_id, message, sender)
	-- CRITICAL: Added 'message.enter' so it only triggers once!
	if message_id == hash("trigger_response") and message.enter then
		local target = nil
		if message.other_group == hash("Game") then target = "MiniGame"
		elseif message.other_group == hash("School") then target = "School"
		elseif message.other_group == hash("Market") then target = "Market"
		end

		if target then
			msg.post("main:/SceneParent#Main", "change_level", { target = target })
		end
	end

	if message_id == hash("move_up") then update_direction(self, "y", 1, message.pressed)
	elseif message_id == hash("move_down") then update_direction(self, "y", -1, message.pressed)
	elseif message_id == hash("move_left") then update_direction(self, "x", -1, message.pressed)
	elseif message_id == hash("move_right") then update_direction(self, "x", 1, message.pressed)
	end
end

function on_input(self, action_id, action)
	local is_pressed = not action.released
	if action_id == hash("up") then update_direction(self, "y", 1, is_pressed)
	elseif action_id == hash("down") then update_direction(self, "y", -1, is_pressed)
	elseif action_id == hash("left") then update_direction(self, "x", -1, is_pressed)
	elseif action_id == hash("right") then update_direction(self, "x", 1, is_pressed)
	end
end