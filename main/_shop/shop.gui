nodes {
  position {
    y: 30.0
  }
  size {
    x: 630.0
    y: 350.0
  }
  type: TYPE_TEXT
  text: "WELCOME TO THE YETI BOUTIQUE!\n"
  "\n"
  "\tExpress your style and keep your Yeti looking sharp!\n"
  "\n"
  "\t1. CUSTOMIZE: Use the arrows to browse through different hats, shirts, and pants.\n"
  "\t2. UNLOCK: Items can be purchased using Coins earned in the Ski Lift. Once bought, they are yours forever!\n"
  "\t3. EQUIP: Already owned items will show as \'EQUIP\'. Click to change your Yeti\'s outfit instantly.\n"
  "\t4. SYNCED CLOSET: Your wardrobe is saved to your account. Your style follows you wherever you go!\n"
  "\n"
  "\tLook good, feel good, and show off your unique Yeti!"
  font: "pixelFont"
  id: "infoText"
  line_break: true
  parent: "infoBox"
  inherit_alpha: true
}
