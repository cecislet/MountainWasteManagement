local GameManager = require("_scripts.GameManager")
local api = require("_scripts.api") 

-- Rate di aumento: 100 punti / 86400 secondi (24h) = ~0.00115
local HUNGER_RATE = 0.00115 

function init(self)
	msg.post(".", "acquire_input_focus")
	msg.post("#MainMenu", "load")
	GameManager.set_current_level("MainMenu")
end

-- --- LOGICA FAME GLOBALE ---
function update(self, dt)
	if GameManager.player_id then
		local base_rate = GameManager.hunger_rate_online or 0.00345

		-- Otteniamo il moltiplicatore dinamico dalle soglie
		local multiplier = GameManager.get_mood_multiplier()

		local total_increase = base_rate * multiplier * dt
		GameManager.hunger = math.min(100, (GameManager.hunger or 0) + total_increase)
	end
end

local function switch_to_level(self, current_level, next_level)
	msg.post("#" .. current_level, "unload")
	msg.post("#" .. next_level, "load")
	GameManager.set_current_level(next_level)
end	

function on_message(self, message_id, message, sender)
	if message_id == hash("proxy_loaded") then
		msg.post(sender, "enable")
		if self.pending_end_message then
			msg.post("Menu:/Gui#Menu", "show_end_menu", self.pending_end_message)
			self.pending_end_message = nil
		end

	elseif message_id == hash("change_level") then
		local current = GameManager.get_current_level()
		local next_level = message.target 

		if next_level and next_level ~= current then
			switch_to_level(self, current, next_level)
		end

	elseif message_id == hash("show_end_menu") then
		self.pending_end_message = {
			coins = message.coins,
			knowledge = message.knowledge,
			reason = message.reason
		}
		switch_to_level(self, "MiniGame", "MiniGameMenu")
	end

	if message_id == hash("trigger_remote_save") then
		api.save(api, function(success)
			print("API: Salvataggio persistente completato: " .. tostring(success))
		end)
	end
end -- <--- Questo chiude on_message