local data = require "_scripts.GameManager" 
local api = require "_scripts.api"

function init(self)
	msg.post(".", "acquire_input_focus")
	self.inventory_open = false
	self.food_box_open = false
	self.selected_item_index = nil 

	-- Inizializzazione UI
	gui.set_enabled(gui.get_node("inventory_bg"), false)
	gui.set_enabled(gui.get_node("foodBox"), false)
end

local function close_inventory(self)
	self.inventory_open = false
	self.food_box_open = false
	self.selected_item_index = nil
	gui.set_enabled(gui.get_node("inventory_bg"), false)
	gui.set_enabled(gui.get_node("foodBox"), false)
	gui.set_enabled(gui.get_node("inventoryOpen"), true)
	gui.set_enabled(gui.get_node("inventoryClose"), false)
end

local function refresh_inventory_slots(self)
	local inv = data.inventory or {}
	local now = os.time() -- Usiamo il tempo locale per coerenza con purchased_at

	for i = 1, 5 do
		local slot_node = gui.get_node("item" .. i)
		local icon_node = gui.get_node("itemIcon" .. i)

		gui.set_enabled(slot_node, true)

		if inv[i] then
			-- Mostra l'icona
			gui.set_enabled(icon_node, true)
			gui.play_flipbook(icon_node, hash(inv[i].icon))

			-- Recuperiamo i dati originali dal GameManager per le soglie di tempo
			local original_data = data.get_item_data_by_id(inv[i].id)
			local time_passed = now - (inv[i].purchased_at or now)

			if original_data then
				if time_passed <= original_data.fresh_duration then
					-- FASE 1: BUONO (Right)
					gui.play_flipbook(slot_node, hash("9SliceRightButton"))
				elseif time_passed <= original_data.max_duration then
					-- FASE 2: NEL MEZZO (Orange)
					gui.play_flipbook(slot_node, hash("9SliceOrangeButton")) -- Assicurati che questo nome esista nell'atlas
				else
					-- FASE 3: SCADUTO (Wrong)
					gui.play_flipbook(slot_node, hash("9SliceWrongButton"))
				end
			end
			gui.set_color(icon_node, vmath.vector4(1, 1, 1, 1))
		else
			-- SLOT VUOTO
			gui.set_enabled(icon_node, false)
			gui.play_flipbook(slot_node, hash("9SliceButton"))
		end
	end
end

function update(self, dt)
	gui.set_text(gui.get_node("money_text"), math.floor(data.coins or 0))
	gui.set_text(gui.get_node("knowledge_text"), math.floor(data.knowledge_amount or 0))
	gui.set_text(gui.get_node("hunger_text"), math.ceil(data.hunger or 0) .. "%")

	-- Aggiorna l'icona del mood del Yeti
	local state_name = data.get_mood_state_name()
	gui.play_flipbook(gui.get_node("yetiMood"), hash(state_name))
end

function on_input(self, action_id, action)
	if action_id ~= hash("touch") then return false end

	-- 1. LOGICA CHIUSURA TOTALE (inventoryClose)
	if action.pressed and gui.pick_node(gui.get_node("inventoryClose"), action.x, action.y) then
		self.inventory_open = false
		self.food_box_open = false
		self.selected_item_index = nil -- Resettiamo la selezione
		gui.set_enabled(gui.get_node("inventory_bg"), false)
		gui.set_enabled(gui.get_node("foodBox"), false)

		gui.set_enabled(gui.get_node("inventoryOpen"), true)
		gui.set_enabled(gui.get_node("inventoryClose"), false)
		return true
	end

	-- 2. LOGICA FOOD BOX (Popup aperto)
	-- Nota: Spostiamo la logica degli slot PRIMA del blocco totale del popup 
	-- se vogliamo che ricliccare lo slot funzioni come interruttore.

	if action.pressed and self.inventory_open then
		for i = 1, 5 do
			local node = gui.get_node("item" .. i)
			-- Controlliamo se esiste un oggetto nell'inventario a quell'indice
			local item = data.inventory[i]

			if gui.pick_node(node, action.x, action.y) and item then
				-- SE RICLICCATO LO STESSO SLOT: CHIUDI
				if self.food_box_open and self.selected_item_index == i then
					self.food_box_open = false
					self.selected_item_index = nil
					gui.set_enabled(gui.get_node("foodBox"), false)
				else
					-- ALTRIMENTI: APRI IL POPUP
					self.selected_item_index = i
					self.food_box_open = true

					local item = data.inventory[i]
					local original_data = data.get_item_data_by_id(item.id)
					if not original_data then 
						print("Errore: Dati non trovati per l'item " .. item.id)
						return true 
					end
					local now = os.time()
					local time_passed = now - (item.purchased_at or now)

					-- 1. ENERGIA (Quanto sfama)
					-- Se il cibo è fresco dà il 100%, se è arancione il 50%, se è rosso peggiora la fame
					local energy_val = original_data.energy or 0
					if time_passed > original_data.max_duration then
						energy_val = -15 -- Cibo avariato
					elseif time_passed > original_data.fresh_duration then
						energy_val = math.floor(energy_val / 2)
					end
					gui.set_text(gui.get_node("energy"), data.get_text("label_energy") .. " " .. energy_val)

					-- 2. CALCOLO DATE (in giorni)
					local function format_days(seconds)
						local d = math.ceil(seconds / 86400)
						return d > 0 and (d .. " " .. data.get_text("days_left")) or data.get_text("expired")
					end

					-- Best Before: entro quanto diventa arancione
					local best_before_remaining = original_data.fresh_duration - time_passed
					gui.set_text(gui.get_node("labelBestBefore"), data.get_text("label_best_before") .. " " .. format_days(best_before_remaining))

					-- Expiry: entro quanto diventa rosso (incomestibile)
					local expiry_remaining = original_data.max_duration - time_passed
					gui.set_text(gui.get_node("labelExpiry"), data.get_text("label_expiry") .. " " .. format_days(expiry_remaining))
					
					gui.play_flipbook(gui.get_node("icon"), hash(item.icon))
					local key = item.icon
					local localized_name = data.get_text(key)
					local localized_desc = data.get_text(key .. "_desc")

					if key:find("popsicle") then
						localized_desc = data.get_text("popsicle_desc")
					end

					gui.set_text(gui.get_node("foodName"), localized_name or item.name)
					gui.set_text(gui.get_node("foodText"), localized_desc or data.get_text("no_description"))

					gui.set_enabled(gui.get_node("foodBox"), true)
				end
				return true
			elseif gui.pick_node(node, action.x, action.y) and not item then
				-- Se clicco uno slot vuoto, non fare nulla (ma blocca il click)
				return true
			end
		end
	end

	-- 3. GESTIONE PULSANTI INTERNI AL FOOD BOX (Eat / Close)
	if self.food_box_open then
		if action.pressed then
			if gui.pick_node(gui.get_node("eat"), action.x, action.y) then
				local item = data.inventory[self.selected_item_index]
				if item then
					data.eat_food(self.selected_item_index)
				end
				close_inventory(self)
				return true
			end
		end
		-- Blocca input che passano attraverso il box (ma non gli slot gestiti sopra)
		if gui.pick_node(gui.get_node("foodBox"), action.x, action.y) then
			return true
		end
	end

	-- 4. APERTURA INVENTARIO (inventoryOpen)
	if action.pressed and gui.pick_node(gui.get_node("inventoryOpen"), action.x, action.y) then
		self.inventory_open = true
		gui.set_enabled(gui.get_node("inventory_bg"), true)
		gui.set_enabled(gui.get_node("inventoryOpen"), false)
		gui.set_enabled(gui.get_node("inventoryClose"), true)
		refresh_inventory_slots(self)
		return true
	end

	-- 5. CHIUSURA AL CLICK ESTERNO (Sfondo)
	if self.inventory_open and action.pressed and gui.pick_node(gui.get_node("inventory_bg"), action.x, action.y) then
		-- Se il popup del cibo NON è aperto, chiudi tutto
		if not self.food_box_open then
			close_inventory(self)
			return true
		else
			-- Se il popup è aperto, chiudi solo se clicchi fuori dal popup stesso
			if not gui.pick_node(gui.get_node("foodBox"), action.x, action.y) then
				close_inventory(self)
				return true
			end
		end
	end

	return false
end