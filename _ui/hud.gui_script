local data = require "_scripts.GameManager" 

function update(self, dt)
	-- 1. Update Money node (Ora usa .coins)
	local money_node = gui.get_node("money_text")
	gui.set_text(money_node, "Cash: $" .. (data.coins or 0))

	-- 2. Update Knowledge node (Usa .knowledge_amount)
	local info_node = gui.get_node("knowledge_text")
	gui.set_text(info_node, "Brain: " .. (data.knowledge_amount or 0))

	-- 3. Update Hunger node 
	-- ATTENZIONE: avevi 'hunger_amount', ma nel GameManager abbiamo messo 'hunger'
	local hunger_node = gui.get_node("hunger_text")
	gui.set_text(hunger_node, "Hunger: " .. math.ceil(data.hunger or 0) .. "%")
end