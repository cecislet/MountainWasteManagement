local data = require "_scripts.GameManager"
local api = require "_scripts.api"

--- --- INIZIALIZZAZIONE --- ---

function init(self)
	msg.post(".", "acquire_input_focus")
	self.inventory_open = false
	self.food_box_open = false
	self.options_open = false
	self.leaderboard_open = false
	self.selected_item_index = nil

	-- Stato iniziale UI
	gui.set_enabled(gui.get_node("inventory_bg"), false)
	gui.set_enabled(gui.get_node("foodBox"), false)
	gui.set_enabled(gui.get_node("OptionsBox"), false)
	gui.set_enabled(gui.get_node("LeaderboardBox"), false)
end

--- --- FUNZIONI DI UTILITÀ --- ---

local function close_inventory(self)
	self.inventory_open = false
	self.food_box_open = false
	self.selected_item_index = nil
	gui.set_enabled(gui.get_node("inventory_bg"), false)
	gui.set_enabled(gui.get_node("foodBox"), false)
	gui.set_enabled(gui.get_node("inventoryOpen"), true)
	gui.set_enabled(gui.get_node("inventoryClose"), false)
end

local function refresh_inventory_slots(self)
	local inv = data.inventory or {}
	local now = os.time()

	for i = 1, 5 do
		local slot_node = gui.get_node("item" .. i)
		local icon_node = gui.get_node("itemIcon" .. i)

		gui.set_enabled(slot_node, true)

		if inv[i] then
			gui.set_enabled(icon_node, true)
			gui.play_flipbook(icon_node, hash(inv[i].icon))

			local original_data = data.get_item_data_by_id(inv[i].id)
			local time_passed = now - (inv[i].purchased_at or now)

			if original_data then
				if time_passed <= original_data.fresh_duration then
					gui.play_flipbook(slot_node, hash("9SliceRightButton")) -- FASE 1: BUONO
				elseif time_passed <= original_data.max_duration then
					gui.play_flipbook(slot_node, hash("9SliceOrangeButton")) -- FASE 2: MEDIO
				else
					gui.play_flipbook(slot_node, hash("9SliceWrongButton")) -- FASE 3: SCADUTO
				end
			end
			gui.set_color(icon_node, vmath.vector4(1, 1, 1, 1))
		else
			gui.set_enabled(icon_node, false)
			gui.play_flipbook(slot_node, hash("9SliceButton")) -- VUOTO
		end
	end
end

local function refresh_leaderboard(self)
	api.get_leaderboard(self, function(success, players)
		if success then
			for i = 1, 10 do
				local name_node = gui.get_node("lb_name" .. i)
				local p_data = players[i]
				if p_data then
					gui.set_text(name_node, i .. ". " .. (p_data.name or "Unknown") .. ": " .. (p_data.high_score or 0) .. "m")
				else
					gui.set_text(name_node, "")
				end
			end
		end
	end)
end

--- --- UPDATE --- ---

function update(self, dt)
	gui.set_text(gui.get_node("money_text"), math.floor(data.coins or 0))
	gui.set_text(gui.get_node("knowledge_text"), math.floor(data.knowledge_amount or 0))
	gui.set_text(gui.get_node("hunger_text"), math.ceil(data.hunger or 0) .. "%")

	local state_name = data.get_mood_state_name()
	gui.play_flipbook(gui.get_node("yetiMood"), hash(state_name))
end

local function refresh_options_texts(self)
	-- Aggiorna i testi dei pulsanti e delle etichette
	gui.set_text(gui.get_node("exitText"), data.get_text("close") or "EXIT")
end
--- --- GESTIONE INPUT --- ---

function on_input(self, action_id, action)
	if action_id ~= hash("touch") or not action.pressed then return false end

	if gui.pick_node(gui.get_node("leaderBoard"), action.x, action.y) then
		self.leaderboard_open = true
		gui.set_enabled(gui.get_node("LeaderboardBox"), true)
		refresh_leaderboard(self)
		return true
	end

	if self.leaderboard_open then
		-- Chiusura (cliccando su un eventuale tasto X o sullo sfondo del box)
		if gui.pick_node(gui.get_node("closeLeaderboard"), action.x, action.y) then
			self.leaderboard_open = false
			gui.set_enabled(gui.get_node("LeaderboardBox"), false)
			return true
		end

		-- Blocca l'input agli elementi sottostanti quando la leaderboard è aperta
		if gui.pick_node(gui.get_node("LeaderboardBox"), action.x, action.y) then 
			return true 
		end
	end

	-- 1. GESTIONE MENU OPZIONI
	if gui.pick_node(gui.get_node("options"), action.x, action.y) then
		self.options_open = true
		gui.set_enabled(gui.get_node("OptionsBox"), true)
		gui.set_text(gui.get_node("exitText"), data.get_text("close") or "EXIT")
		gui.set_text(gui.get_node("saveResult"), "")

		local flag_node = gui.get_node("language")
		local flag_icon = (data.current_language == "en") and "USA" or "SwissItaly"
		gui.play_flipbook(flag_node, hash(flag_icon))
		return true
	end

	if self.options_open then
		if gui.pick_node(gui.get_node("exit"), action.x, action.y) then
			self.options_open = false
			gui.set_enabled(gui.get_node("OptionsBox"), false)
		elseif gui.pick_node(gui.get_node("user"), action.x, action.y) then
			data.player_id = nil
			msg.post("main:/SceneParent#Main", "change_level", { target = "MainMenu" })
		elseif gui.pick_node(gui.get_node("language"), action.x, action.y) then
			local new_lang = (data.current_language == "it") and "en" or "it"
			local new_flag = (new_lang == "en") and "USA" or "SwissItaly"
			data.load_language(new_lang)
			gui.play_flipbook(gui.get_node("language"), hash(new_flag))
			gui.set_text(gui.get_node("exitText"), data.get_text("close") or "EXIT")
		elseif gui.pick_node(gui.get_node("save"), action.x, action.y) then
			gui.set_text(gui.get_node("saveResult"), data.get_text("msg_saving") or "Saving...")
			api.save(self, function(success)
				if success then
					gui.set_text(gui.get_node("saveResult"), data.get_text("msg_save_ok") or "Game Saved!")
					timer.delay(3, false, function()
						self.options_open = false
						gui.set_enabled(gui.get_node("OptionsBox"), false)
					end)
				else
					gui.set_text(gui.get_node("saveResult"), data.get_text("msg_save_error") or "Save Failed!")
				end
			end)
		end
		return true -- Blocca input sotto le opzioni
	end

	-- 2. GESTIONE INVENTARIO (APERTURA/CHIUSURA)
	if gui.pick_node(gui.get_node("inventoryOpen"), action.x, action.y) then
		self.inventory_open = true
		gui.set_enabled(gui.get_node("inventory_bg"), true)
		gui.set_enabled(gui.get_node("inventoryOpen"), false)
		gui.set_enabled(gui.get_node("inventoryClose"), true)
		refresh_inventory_slots(self)
		return true
	elseif gui.pick_node(gui.get_node("inventoryClose"), action.x, action.y) then
		close_inventory(self)
		return true
	end

	-- 3. LOGICA SLOT INVENTARIO E FOOD BOX
	if self.inventory_open then
		-- Controllo click sugli slot
		for i = 1, 5 do
			local node = gui.get_node("item" .. i)
			local item = data.inventory[i]

			if gui.pick_node(node, action.x, action.y) and item then
				if self.food_box_open and self.selected_item_index == i then
					self.food_box_open = false
					gui.set_enabled(gui.get_node("foodBox"), false)
				else
					-- Apri/Aggiorna Food Box
					self.selected_item_index = i
					self.food_box_open = true

					local original_data = data.get_item_data_by_id(item.id)
					local now = os.time()
					local time_passed = now - (item.purchased_at or now)

					-- Calcolo energia e testi
					local energy_val = originaminil_data.energy or 0
					if time_passed > original_data.max_duration then
						energy_val = -15
					elseif time_passed > original_data.fresh_duration then
						energy_val = math.floor(energy_val / 2)
					end

					local function format_days(seconds)
						if seconds <= 0 then return data.get_text("expired") end
						if seconds < 3600 then return math.ceil(seconds / 60) .. " m"
						elseif seconds < 86400 then return math.ceil(seconds / 3600) .. " h"
						else return math.ceil(seconds / 86400) .. " " .. data.get_text("days_left") end
					end

					gui.set_text(gui.get_node("energy"), data.get_text("label_energy") .. " " .. energy_val)
					gui.set_text(gui.get_node("labelBestBefore"), data.get_text("label_best_before") .. " " .. format_days(original_data.fresh_duration - time_passed))
					gui.set_text(gui.get_node("labelExpiry"), data.get_text("label_expiry") .. " " .. format_days(original_data.max_duration - time_passed))

					gui.play_flipbook(gui.get_node("icon"), hash(item.icon))
					gui.set_text(gui.get_node("foodName"), data.get_text(item.icon) or item.name)
					gui.set_text(gui.get_node("foodText"), data.get_text(item.icon .. "_desc") or data.get_text("no_description"))
					gui.set_text(gui.get_node("trashText"), data.get_text("button_trash") or "TRASH")
					gui.set_text(gui.get_node("eatText"), data.get_text("button_eat") or "EAT")

					gui.set_enabled(gui.get_node("foodBox"), true)
				end
				return true
			end
		end

		-- Pulsanti interni al Food Box
		if self.food_box_open then
			if gui.pick_node(gui.get_node("eat"), action.x, action.y) then
				data.eat_food(self.selected_item_index)
				close_inventory(self)
				return true
			elseif gui.pick_node(gui.get_node("trash"), action.x, action.y) then
				data.discard_food(self.selected_item_index)
				close_inventory(self)
				return true
			end

			if gui.pick_node(gui.get_node("foodBox"), action.x, action.y) then return true end
		end

		-- Chiusura cliccando lo sfondo
		if gui.pick_node(gui.get_node("inventory_bg"), action.x, action.y) then
			close_inventory(self)
			return true
		end
	end

	return false
end