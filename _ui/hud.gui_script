local data = require "_scripts.GameManager" 

-- Funzione locale per gestire il cambio della faccia e della barra
local function update_yeti_visuals(self)
	-- 1. Otteniamo il nome dello stato (HAPPY, SAD, ecc.) basato sul punteggio 0-100
	local state_name = data.get_mood_state_name()
	local face_node = gui.get_node("yetiMood")

	-- 2. Cambiamo l'immagine nel flipbook
	gui.play_flipbook(face_node, hash(state_name))
end

function update(self, dt)
	-- 1. Update Money node (Cash)
	local money_node = gui.get_node("money_text")
	gui.set_text(money_node, "Cash: $" .. math.floor(data.coins or 0))

	-- 2. Update Knowledge node (Brain)
	local info_node = gui.get_node("knowledge_text")
	gui.set_text(info_node, "Brain: " .. math.floor(data.knowledge_amount or 0))

	-- 3. Update Hunger node (Fame)
	local hunger_node = gui.get_node("hunger_text")
	gui.set_text(hunger_node, "Hunger: " .. math.ceil(data.hunger or 0) .. "%")

	-- 4. NUOVO: Update Mood & Face
	-- Chiamiamo la funzione ogni frame per riflettere i cambiamenti di stato
	update_yeti_visuals(self)
end